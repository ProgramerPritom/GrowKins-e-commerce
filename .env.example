# GrowKins Frontend Production Environment Variables
# Set these variables in your Vercel Project Settings > Environment Variables

# Connect to Live Backend (set to false for Google Sheets & Drive API live mode)
VITE_USE_MOCK_API=false

# Your deployed backend API URL (e.g. your backend on Vercel or Render)
VITE_API_BASE_URL=https://your-backend-app.vercel.app/api/growkins
